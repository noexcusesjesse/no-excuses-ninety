# No Excuses Reset Program — Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# For Railway, set these in the service Variables tab.
# NEVER commit the real .env file.

# Postgres connection string. Required locally and on Railway.
# Local example:
#   postgres://USER:PASSWORD@localhost:5432/noexcuses
# Railway: connect the existing Postgres plugin to this service.
# Railway injects DATABASE_URL automatically once Postgres is linked.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/noexcuses

# Session secret for iron-session. MUST be at least 32 characters.
# Generate a secure one: openssl rand -base64 32
SESSION_SECRET=dev-insecure-session-secret-replace-in-production-32chars
