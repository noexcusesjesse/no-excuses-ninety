# No Excuses Ninety — Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# For Railway deployment, set these as environment variables in the
# Railway dashboard (Settings → Variables).

# SQLite database path. Defaults to ./data/app.db (local dev).
# For Railway: set to /data/app.db and add a persistent volume mounted at /data.
DATABASE_PATH=./data/app.db

# Session secret for iron-session. MUST be at least 32 characters.
# Generate a secure one: openssl rand -base64 32
# NEVER commit the real .env file with a production secret.
SESSION_SECRET=dev-insecure-session-secret-replace-in-production-32chars
